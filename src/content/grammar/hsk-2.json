  {
   "id": "g-hsk2-yixia",
   "level": 2,
   "title": "Động từ + 一下",
   "pattern": "Động từ + 一下",
   "explain": "一下 sau động từ làm câu nhẹ nhàng, “… một chút / thử”: 介绍一下, 等一下, 看一下.",
   "vnPitfalls": [
    "一下 đứng SAU động từ: ❌ 一下介绍 → ✅ 介绍一下"
   ],
   "examples": [
    {
     "zh": "我介绍一下，这是我朋友。",
     "py": "Wǒ jièshào yīxià, zhè shì wǒ péngyou.",
     "vi": "Để tôi giới thiệu, đây là bạn tôi."
    },
    {
     "zh": "请等一下。",
     "py": "Qǐng děng yīxià.",
     "vi": "Xin đợi một chút."
    }
   ],
   "exercises": [
    {
     "type": "order",
     "tokens": [
      "一下",
      "你",
      "看"
     ],
     "answer": "你看一下",
     "vi": "Bạn xem một chút."
    },
    {
     "type": "fill",
     "text": "请等＿。",
     "options": [
      "一下",
      "一起",
      "一些"
     ],
     "answer": "一下",
     "vi": "Xin đợi một chút."
    },
    {
     "type": "choose",
     "prompt": "Câu đúng là:",
     "options": [
      "我一下介绍。",
      "我介绍一下。",
      "一下我介绍。"
     ],
     "answer": "我介绍一下。"
    }
   ]
  },
  {

    {
     "zh": "他是我的老师。",
     "py": "Tā shì wǒ de lǎoshī.",
     "vi": "Ông ấy là thầy của tôi."
    }
   ],
   "exercises": [
    {
     "type": "order",
     "tokens": [
      "名字",
      "我",
      "的"
     ],
     "answer": "我的名字",
     "vi": "Tên của tôi"
    },
    {
     "type": "fill",
     "text": "这是她＿书。",
     "options": [
      "的",
      "是",
      "吗"
     ],
     "answer": "的",
     "vi": "Đây là sách của cô ấy."
    },
    {
     "type": "choose",
     "prompt": "“Bạn của tôi” là:",
     "options": [
      "朋友的我",
      "我的朋友",
      "我朋友的"
     ],
     "answer": "我的朋友"
    }
   ]
  },

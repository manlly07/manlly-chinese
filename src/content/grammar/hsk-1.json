 "items": [
  {
   "id": "g-hsk1-shi",
   "level": 1,
   "title": "Câu chữ 是",
   "pattern": "A 是 B",
   "explain": "是 nối hai danh từ, nghĩa là “là”. Phủ định: A 不是 B.",
   "vnPitfalls": [
    "Không dùng 是 trước tính từ: ❌ 我是好 → ✅ 我很好"
   ],
   "examples": [
    {
     "zh": "我是学生。",
     "py": "Wǒ shì xuésheng.",
     "vi": "Tôi là học sinh."
    },
    {
     "zh": "她不是老师。",
     "py": "Tā bù shì lǎoshī.",
     "vi": "Cô ấy không phải giáo viên."
    }
   ],
   "exercises": [
    {
     "type": "order",
     "tokens": [
      "是",
      "我",
      "老师"
     ],
     "answer": "我是老师",
     "vi": "Tôi là giáo viên."
    },
    {
     "type": "fill",
     "text": "你＿学生吗？",
     "options": [
      "是",
      "很",
      "不"
     ],
     "answer": "是",
     "vi": "Bạn là học sinh à?"
    },
    {
     "type": "choose",
     "prompt": "Chọn câu đúng",
     "options": [
      "我是很好。",
      "我很好。",
      "我好是。"
     ],
     "answer": "我很好。"
    }
   ]
  },
  {
   "id": "g-hsk1-ma",
   "level": 1,
   "title": "Câu hỏi với 吗",
   "pattern": "Câu trần thuật + 吗？",
   "explain": "Thêm 吗 vào cuối câu trần thuật để hỏi có/không — giống “… không?”, “… à?” trong tiếng Việt.",
   "vnPitfalls": [
    "Đã có từ để hỏi (什么, 谁…) thì không thêm 吗: ❌ 你叫什么名字吗？"
   ],
   "examples": [
    {
     "zh": "你是老师吗？",
     "py": "Nǐ shì lǎoshī ma?",
     "vi": "Bạn là giáo viên à?"
    },
    {
     "zh": "你好吗？",
     "py": "Nǐ hǎo ma?",
     "vi": "Bạn khỏe không?"
    }
   ],
   "exercises": [
    {
     "type": "order",
     "tokens": [
      "吗",
      "你",
      "学生",
      "是"
     ],
     "answer": "你是学生吗",
     "vi": "Bạn là học sinh à?"
    },
    {
     "type": "fill",
     "text": "你是老师＿？",
     "options": [
      "吗",
      "呢",
      "的"
     ],
     "answer": "吗",
     "vi": "Bạn là giáo viên à?"
    },
    {
     "type": "choose",
     "prompt": "Câu nào đúng?",
     "options": [
      "你叫什么名字吗？",
      "你叫什么名字？",
      "你吗叫什么名字？"
     ],
     "answer": "你叫什么名字？"
    }
   ]
  },
  {
